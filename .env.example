# Шаблон .gitignore
# ---------- Postgres ----------
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_in_real_env
POSTGRES_DB=content_factory
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# SQLAlchemy URL (psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://app:change_me_in_real_env@postgres:5432/content_factory

# ---------- ComfyUI ----------
# Release 1: ComfyUI запущен на хосте → host.docker.internal
COMFY_URL=http://host.docker.internal:8188
# Release 2: ComfyUI — отдельный сервис в compose
# COMFY_URL=http://comfyui:8188

# Папка output ComfyUI на ХОСТЕ — монтируется read-only в api
COMFY_OUTPUT_HOST=/mnt/d/Development/ComfyUI_WSL/output
# Путь внутри контейнера api (НЕ менять без правки compose)
COMFY_OUTPUT_DIR=/comfy_output

# Имя save-узла в workflow, из которого брать filename
COMFY_SAVE_NODE_ID=9

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=dev-local-key-change-me      # для прода — openssl rand -hex 32
RATE_LIMIT_PER_MIN=30
ALLOWED_ORIGINS=http://localhost:3000

# ---------- Worker ----------
WORKER_POLL_INTERVAL_SEC=2
WORKER_COMFY_POLL_INTERVAL_SEC=2
WORKER_COMFY_TIMEOUT_SEC=600